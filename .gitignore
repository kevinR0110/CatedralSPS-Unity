# ============================================
# .gitignore para proyecto Unity - CatedralSPS
# ============================================

# Carpetas generadas por Unity (se regeneran solas, no se suben)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Builds (el ejecutable se entrega aparte, en un .zip o en GitHub Releases)
/[Bb]uild/
/[Bb]uilds/

# Archivos de Visual Studio / IDE
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos autogenerados por Unity
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics / Crash reports
crashlytics-build.properties

# Capturas del Profiler
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
